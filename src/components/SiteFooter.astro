---
import logo from '../assets/logo.svg';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href={base}>
        <img src={logo.src} width="32" height="32" alt="" />
        <span>helios</span>
      </a>
      <p>Drift detection and self-healing for Ansible, from Git to every host.</p>
    </div>

    <div class="footer-links">
      <div>
        <h3>Product</h3>
        <a href={`${base}#product`}>Overview</a>
        <a href={`${base}#how-it-works`}>How it works</a>
        <a href={`${base}#security`}>Security</a>
        <a href={`${base}#quickstart`}>Quick start</a>
      </div>
      <div>
        <h3>Docs</h3>
        <a href={`${base}quickstart/`}>Get started</a>
        <a href={`${base}install/`}>Install</a>
        <a href={`${base}k3s/`}>Kubernetes</a>
        <a href={`${base}ha/`}>High availability</a>
      </div>
      <div>
        <h3>Project</h3>
        <a href="https://github.com/SlimaineB/helios">GitHub</a>
        <a href="https://github.com/SlimaineB/helios/releases">Releases</a>
        <a href={`${base}development/`}>Contributing</a>
        <a href="https://github.com/SlimaineB/helios/blob/main/README.md">README</a>
      </div>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>&copy; {year} Helios</span>
    <span>Open source · Self-hosted on your servers or Kubernetes</span>
  </div>
</footer>
