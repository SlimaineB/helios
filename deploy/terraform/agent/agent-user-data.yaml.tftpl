#cloud-config
# Generated from template by terraform.
write_files:
  - path: /etc/helios/agent.yaml
    permissions: "0600"
    content: |
      server: ${server}
      token: ${token}
      state_dir: /var/lib/helios
      poll_interval: 5m
      max_concurrent_apps: 4
      autoheal: true

  - path: /etc/systemd/system/helios-agent.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Helios agent (ansible-pull drift controller)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/helios-agent -config /etc/helios/agent.yaml
      Environment=HOME=/root
      Restart=always
      RestartSec=10
      ProtectSystem=strict
      ProtectHome=true
      ReadWritePaths=/var/lib/helios /tmp
      PrivateTmp=true
      NoNewPrivileges=true

      [Install]
      WantedBy=multi-user.target

runcmd:
  - mkdir -p /var/lib/helios
  - command -v git >/dev/null || (dnf install -y git)
  - command -v ansible-playbook >/dev/null || (dnf install -y python3-pip && pip3 install ansible-core && ansible-galaxy collection install ansible.posix)
  - [ -x /usr/local/bin/helios-agent ] || curl -fsSL -o /usr/local/bin/helios-agent ${agent_url}
  - chmod +x /usr/local/bin/helios-agent
  - systemctl daemon-reload
  - systemctl enable --now helios-agent