# /etc/helios/runner.env — consumed by helios-runner.service
HELIOS_SERVER=https://helios.example.com
HELIOS_RUNNER_TOKEN=replace-with-the-hub-runner-token

# SSH identity used to reach tunneled hosts (dedicated, port-forwarding-only key).
HELIOS_RUNNER_SSH_USER=helios-tunnel
HELIOS_RUNNER_SSH_KEY=/etc/helios/runner_id
HELIOS_RUNNER_SSH_COMMON_ARGS=-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/var/lib/helios/runner/known_hosts

# Optional tuning.
# HELIOS_RUNNER_STATE_DIR=/var/lib/helios/runner
# HELIOS_RUNNER_POLL_INTERVAL=30s
# HELIOS_RUNNER_DISCOVER_INTERVAL=15s
# HELIOS_RUNNER_MAX_CONCURRENT=4
# HELIOS_RUNNER_ANSIBLE_BIN=ansible-playbook
