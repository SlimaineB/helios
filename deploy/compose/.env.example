# Copy to .env and edit. Never commit .env.
# The pre-rename ANH_* / ANSIBLEHUB_* names are still accepted as fallbacks.
#
# Generate a password with: openssl rand -base64 32
HELIOS_OPERATOR_USER=admin
HELIOS_OPERATOR_PASSWORD=replace-with-a-long-random-password

# Public URL used for OIDC redirects and secure cookies. Set to https://... behind TLS.
HELIOS_BASE_URL=http://localhost:8080

# Host port / bind address. Prefer 127.0.0.1 behind a reverse proxy.
HELIOS_BIND_ADDR=127.0.0.1
HELIOS_PORT=8080

# Released image. Keep this for a normal install (no build required).
# For local development, set HELIOS_IMAGE=helios-server:local and use --build.
HELIOS_IMAGE=ghcr.io/slimaineb/helios-server:latest

# Required only with compose.postgres.yaml. Use a URL-safe password.
# HELIOS_POSTGRES_PASSWORD=replace-with-another-long-random-password

# Tunnel mode (optional). Shared runner token; leave empty to disable the
# runner API. Set the gateway shown to operators and the hub loopback port range.
# HELIOS_RUNNER_TOKEN=replace-with-a-long-random-runner-token
# HELIOS_TUNNEL_GATEWAY=helios-tunnel@bastion.example.com
# HELIOS_TUNNEL_PORT_MIN=22000
# HELIOS_TUNNEL_PORT_MAX=22999

# Shared repo snapshot cache (optional but enabled by default in compose).
# Agents download immutable tarballs instead of cloning each repo every run.
# Snapshots are pruned by age and total size so the volume stays bounded.
# HELIOS_REPO_CACHE_TTL=168h
# HELIOS_REPO_CACHE_MAX_MB=2048
# HELIOS_REPO_CACHE_RESOLVE_TTL=30s
