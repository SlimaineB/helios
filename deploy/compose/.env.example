# Copy to .env and edit. Never commit .env.
#
# Generate a password with: openssl rand -base64 32
ANH_OPERATOR_USER=admin
ANH_OPERATOR_PASSWORD=replace-with-a-long-random-password

# Public URL used for OIDC redirects and secure cookies. Set to https://... behind TLS.
ANH_BASE_URL=http://localhost:8080

# Host port / bind address. Prefer 127.0.0.1 behind a reverse proxy.
ANH_BIND_ADDR=0.0.0.0
ANH_PORT=8080

# Optional image override (defaults to a local build).
# ANH_IMAGE=registry.example.com/ansiblehub/server:1.2.3

# Required only with compose.postgres.yaml. Use a URL-safe password.
# ANH_POSTGRES_PASSWORD=replace-with-another-long-random-password
