[Unit]
Description=Helios bastion runner (agentless reverse-SSH instances)
Documentation=https://github.com/SlimaineB/helios
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helios-runner
Group=helios-runner
Environment=HOME=/var/lib/helios/runner
EnvironmentFile=-/etc/helios/runner.env
ExecStart=/usr/local/bin/helios-runner
Restart=always
RestartSec=10s
StateDirectory=helios/runner
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
