[Unit]
Description=AnsibleHub agent (ansible-pull drift controller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ansiblehub-agent -config /etc/ansiblehub/agent.yaml
Environment=HOME=/root
Restart=always
RestartSec=10
# A configuration-management agent runs arbitrary playbooks as root: it must
# create users, write /etc and persist state under /tmp, so no filesystem or
# tmp namespace restrictions here.

[Install]
WantedBy=multi-user.target