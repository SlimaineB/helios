# Lab defaults for the full Dex + PostgreSQL example. Copy to .env and change
# the passwords before exposing anything.
HELIOS_OPERATOR_USER=admin
HELIOS_OPERATOR_PASSWORD=changeme

HELIOS_POSTGRES_PASSWORD=helios-example
HELIOS_DEX_CLIENT_SECRET=dex-example-secret

# Encrypts stored repository credentials and secret variables. Changing it
# makes already-stored ciphertext unreadable; keep it with the database backup.
HELIOS_SECRET_KEY=9c1f4d6e8a2b7c3d5f0e1a4b6c8d2e9f3a5b7c1d4e6f8a0b2c4d6e8f1a3b5c7d

# Number of demo agents registered by the bootstrap container.
NUM_AGENTS=2
