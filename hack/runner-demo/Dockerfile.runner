# Bastion runner for the optional `--runner` lab profile.
# Build context: repository root.
FROM golang:1.25-alpine AS build
WORKDIR /build
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/helios-runner ./cmd/runner

FROM python:3.11-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates openssh-client openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages ansible-core \
    && ansible-galaxy collection install ansible.posix -p /usr/share/ansible/collections \
    && mkdir -p /run/sshd /var/lib/helios/runner /conf
COPY --from=build /out/helios-runner /usr/local/bin/helios-runner
COPY hack/runner-demo/runner-entrypoint.sh /usr/local/bin/runner-entrypoint.sh
RUN chmod +x /usr/local/bin/runner-entrypoint.sh
ENV HOME=/var/lib/helios/runner
EXPOSE 2223
ENTRYPOINT ["/usr/local/bin/runner-entrypoint.sh"]
